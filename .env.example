# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Data Files
SERVICES_FILE=services.json
SERVICES_NO_STAFF_FILE=services_no_staff.json

# Logging
LOG_LEVEL=INFO

# Application Settings
DEBUG=False
APP_MODE=production  # development, testing, production
INTERACTIVE_MODE=True

# Performance Settings
PERFORMANCE_MODE=balanced  # speed, quality, balanced
ENABLE_CACHING=True
CACHE_TTL=300  # Cache TTL in seconds
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MAX_MESSAGE_LENGTH=4096
TELEGRAM_CONTEXT_TTL_HOURS=24
TELEGRAM_MAX_CONTEXT_MESSAGES=20
TELEGRAM_ENABLE_BUTTONS=True